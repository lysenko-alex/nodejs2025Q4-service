# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library
POSTGRES_PORT=5432

# Application Configuration
PORT=4000
BASE_URL=http://localhost:4000

# Database Connection URL
# NOTE: When using Docker Compose, this is automatically constructed from POSTGRES_* variables above.
#       You only need to set this for local development (without Docker).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker Compose: HOST is 'postgres' (service name), PORT is 5432 (internal container port)
# For local development: HOST is 'localhost', PORT is your local PostgreSQL port
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/home_library

# PostgreSQL Healthcheck Configuration (optional - defaults provided)
POSTGRES_HEALTHCHECK_INTERVAL=10s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=5
